//| mill-version: 1.1.10
//| mvnDeps:
//| - "com.goyeau::mill-scalafix::0.6.2"
//| - "com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION"
//| - "ch.epfl.scala:scalafix-interfaces:0.14.9" # Only new scalafix support 3.10
//| - "de.tototec::de.tobiasroeser.mill.jacoco::0.1.0"
//| mill-jvm-opts: ["--enable-preview"]

package build
import build.Platform.*
import com.goyeau.mill.scalafix.ScalafixModule
import de.tobiasroeser.mill.jacoco.{JacocoReportModule, JacocoTestModule}
import mill.*
import mill.api.ModuleRef
import mill.contrib.scoverage.{ScoverageModule, ScoverageReport}
import mill.javalib.publish.{PomSettings, VersionControl}
import mill.scalalib.*
import mill.scalalib.publish.{Developer, License}

object jacocoUnit extends JacocoReportModule {
  override def jacocoVersion: T[String] = "0.8.16"

  override def jacocoReportFull(
      evaluator: mill.api.Evaluator
  ): Task.Command[PathRef] = Task.Command {
    // By default, Jacoco will include all the sources and compiled classes which includes Scala + scoverage
    // Jacoco fails, because it tries to load the same class twice.
    jacocoReportTask(
      evaluator = evaluator,
      sources = "joiners.allSources",
      compiled = "joiners.compile",
      excludeSources = "",
      excludeCompiled = ""
    )()
  }

}

val javaBuild = 24

enum Platform {
  case WindowsX64, WindowsArm64, MacX64, MacArm64, LinuxX64, LinuxArm64
}

object Platform {
  def current: Platform = {
    val os = sys.props("os.name").toLowerCase
    val arch = sys.props("os.arch").toLowerCase
    val isArm = arch == "aarch64" || arch == "arm64"
    if (os.contains("win")) { if (isArm) WindowsArm64 else WindowsX64 }
    else if (os.contains("mac")) { if (isArm) MacArm64 else MacX64 }
    else if (os.contains("linux")) { if (isArm) LinuxArm64 else LinuxX64 }
    else sys.error(s"Unsupported platform: $os / $arch")
  }
}

trait MyPublishModule extends PublishModule {
  override def publishVersion: T[String] = "0.0.0-DEV"

  override def pomSettings: T[PomSettings] = PomSettings(
    description = "Structured Concurrency utils for Scala",
    organization = "pl.andrzejressel",
    url = "https://joiners.readthedocs.io/en/latest/",
    licenses = Seq(License.`GPL-2.0-with-classpath-exception`),
    versionControl = VersionControl.github("andrzejressel", "joiners"),
    developers = Seq(
      Developer(
        id = "andrzejressel",
        name = "Andrzej Ressel",
        email = "github@andrzejressel.pl"
      )
    )
  )
}

trait MyModule extends JavaModule {

  override def jvmVersion: T[String] = Task.Input {
    Platform.current match {
      case WindowsX64 =>
        s"https://download.java.net/java/early_access/jdk28/${javaBuild}/GPL/openjdk-28-ea+${javaBuild}_windows-x64_bin.zip"
      case WindowsArm64 =>
        sys.error("TODO: add Windows arm64 JVM url")
      case MacX64 =>
        sys.error("TODO: add Mac x64 JVM url")
      //      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-macosx-x64.tar.gz"
      case MacArm64 =>
        s"https://download.java.net/java/early_access/jdk28/${javaBuild}/GPL/openjdk-28-ea+${javaBuild}_macos-aarch64_bin.tar.gz"
      case LinuxX64 =>
        s"https://download.java.net/java/early_access/jdk28/${javaBuild}/GPL/openjdk-28-ea+${javaBuild}_linux-x64_bin.tar.gz"
      case LinuxArm64 =>
        s"https://download.java.net/java/early_access/jdk28/${javaBuild}/GPL/openjdk-28-ea+${javaBuild}_linux-aarch64_bin.tar.gz"
    }
  }

}

trait MyJavaModule extends MyModule {

  trait MyTest extends JavaTests with TestModule.Junit6 with JacocoTestModule {
    override def jupiterVersion: T[String] = "6.0.2"

    override def jacocoReportModule = ModuleRef(jacocoUnit)
  }
}

trait MyScalaModule
    extends ScalaModule
    with MyModule
    with ScoverageModule
    with ScalafixModule {
  self =>
  def scalaVersion = "3.10.0"

  override lazy val scoverage: ScoverageData = new ScoverageData {
    override def jvmVersion = Task {
      self.jvmVersion()
    }
  }
  override def scoverageVersion: T[String] = "2.5.2"

  override def scalaDocOptions = super.scalaDocOptions() ++ Seq(
    "-external-mappings:" +
      s".*scala.*::scaladoc3::https://scala-lang.org/api/3.x/," +
      s".*java.*::javadoc::https://docs.oracle.com/en/java/javase/27/docs/api/java.base/"
  )

  private def isInCI: T[Boolean] = Task.Input {
    Task.env.contains("CI")
  }

  private def ciScalacOptions: T[Seq[String]] = Task {
    if (isInCI()) {
      Seq(
        "-Werror"
      )
    } else {
      Seq.empty
    }
  }

  override def scalacOptions: T[Seq[String]] = super.scalacOptions() ++ Seq(
    "-source:future",
    "-rewrite",
    "-new-syntax",
    "-Wunused:all",
    "-encoding",
    "utf8",
    "-feature"
  ) ++ ciScalacOptions()

  trait MyTest
      extends ScalaTests
      with TestModule.Munit
      with ScoverageTests
      with ScalafixModule {
    override def munitVersion: T[String] = "1.3.4"
  }
}

object `joiners` extends MyJavaModule with MyPublishModule {

  private def docsDirectory = Task.Source(moduleDir / os.up / "docs")
  private def markdownFiles = Task {
    os.walk(docsDirectory().path).filter(_.ext == "md").sorted.map(PathRef(_))
  }

  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"pl.andrzejressel:oneof:0.0.2",
    mvn"io.arxila.javatuples:javatuples:2.0.1"
  )

  def javadocOptions = Task {
    super.javadocOptions() ++ Seq(
      "-link",
      "https://javadoc.io/doc/io.arxila.javatuples/javatuples/2.0.1",
      "-link",
      "https://javadoc.io/doc/pl.andrzejressel/oneof/0.0.2"
    )
  }

  override def artifactName: T[String] = "joiners"

  object test extends MyTest {

    override def sources: T[Seq[PathRef]] = super.sources() ++ generatedTests()

    private def generatedTests = Task {
      val files = markdownFiles().map(_.path.toString)
      java_docs_extractor.runner().run(args = files)
      Seq(PathRef(Task.dest))
    }
  }

}

object `joiners4s` extends MyScalaModule with MyPublishModule {

  override def moduleDeps: Seq[PublishModule] =
    super.moduleDeps ++ Seq(`joiners`)

  override def artifactName: T[String] = "joiners4s"

  object test extends MyTest {}

}

object `java_docs_extractor` extends MyScalaModule {
  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.commonmark:commonmark:0.32.0",
    mvn"org.apache.commons:commons-text:1.15.0"
  )

  object test extends MyTest {}

}

object scoverage extends ScoverageReport {
  override def scalaVersion = "3.10.0"

  override def scoverageVersion = "2.5.2"
}
