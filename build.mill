//| mill-jvm-opts: ["--enable-preview"]

package build
import mill.*
import scalalib.*
import com.goyeau.mill.scalafix.ScalafixModule
import coursier.{MavenRepository, Repository}
import mill.contrib.scoverage.ScoverageModule
import mill.contrib.scoverage.ScoverageReport
import mill.javalib.publish.{PomSettings, VersionControl}
import mill.scalalib.publish.{Developer, License}
import de.tobiasroeser.mill.jacoco.JacocoTestModule
import de.tobiasroeser.mill.jacoco.JacocoReportModule
import mill.api.{Discover, ExternalModule, ModuleRef}

object jacocoUnit extends JacocoReportModule {
  override def jacocoVersion: T[String] = "0.8.16"

  override def jacocoReportFull(
      evaluator: mill.api.Evaluator
  ): Task.Command[PathRef] = Task.Command {
    // By default, Jacoco will include all the sources and compiled classes which includes Scala + scoverage
    // Jacoco fails, because it tries to load the same class twice.
    jacocoReportTask(
      evaluator = evaluator,
      sources = "joiners.allSources",
      compiled = "joiners.compile",
      excludeSources = "",
      excludeCompiled = ""
    )()
  }

}

enum Platform {
  case WindowsX64, WindowsArm64, MacX64, MacArm64, LinuxX64, LinuxArm64

  def jvmUrl: String = this match {
    case WindowsX64 =>
      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-windows-x64-jdk.zip"
    case WindowsArm64 =>
      sys.error("TODO: add Windows arm64 JVM url")
    case MacX64 =>
      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-macosx-x64.tar.gz"
    case MacArm64 =>
      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-macosx-aarch64.tar.gz"
    case LinuxX64 =>
      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-linux-x64.tar.gz"
    case LinuxArm64 =>
      "https://corretto.aws/downloads/resources/27.0.0.35.1/amazon-corretto-27.0.0.35.1-linux-aarch64.tar.gz"
  }
}

object Platform {
  def current: Platform = {
    val os = sys.props("os.name").toLowerCase
    val arch = sys.props("os.arch").toLowerCase
    val isArm = arch == "aarch64" || arch == "arm64"
    if (os.contains("win")) { if (isArm) WindowsArm64 else WindowsX64 }
    else if (os.contains("mac")) { if (isArm) MacArm64 else MacX64 }
    else if (os.contains("linux")) { if (isArm) LinuxArm64 else LinuxX64 }
    else sys.error(s"Unsupported platform: $os / $arch")
  }
}

trait MyModule extends JavaModule with PublishModule {

  override def jvmVersion = Platform.current.jvmUrl

  override def publishVersion: T[String] = "0.0.0-DEV"

  override def pomSettings: T[PomSettings] = PomSettings(
    description = "Structured Concurrency utils for Scala",
    organization = "pl.andrzejressel",
    url = "https://joiners.readthedocs.io/en/latest/",
    licenses = Seq(License.`GPL-2.0-with-classpath-exception`),
    versionControl = VersionControl.github("andrzejressel", "joiners"),
    developers = Seq(
      Developer(
        id = "andrzejressel",
        name = "Andrzej Ressel",
        email = "github@andrzejressel.pl"
      )
    )
  )

}

trait MyJavaModule extends MyModule {

  override def javacOptions: T[Seq[String]] = super.javacOptions() ++ Seq("--release", "27", "--enable-preview")

  object test extends JavaTests with TestModule.Junit6 with JacocoTestModule {
    override def jupiterVersion: T[String] = "6.0.2"

    override def forkArgs: T[Seq[String]] = super.forkArgs() ++ Seq("--enable-preview")

    override def jacocoReportModule = ModuleRef(jacocoUnit)
  }
}

trait MyScalaModule
    extends ScalaModule
    with MyModule
    with ScoverageModule
    with ScalafixModule {
  self =>
  def scalaVersion = "3.10.0"

  override lazy val scoverage: ScoverageData = new ScoverageData {
    override def jvmVersion = Task {
      self.jvmVersion()
    }
  }
  override def scoverageVersion: T[String] = "2.5.2"

  override def scalaDocOptions = super.scalaDocOptions() ++ Seq(
    "-external-mappings:" +
      s".*scala.*::scaladoc3::https://scala-lang.org/api/3.x/," +
      s".*java.*::javadoc::https://docs.oracle.com/en/java/javase/27/docs/api/java.base/"
  )

  private def isInCI: T[Boolean] = Task.Input {
    Task.env.contains("CI")
  }

  private def ciScalacOptions: T[Seq[String]] = Task {
    if (isInCI()) {
      Seq(
        "-Werror"
      )
    } else {
      Seq.empty
    }
  }

  override def scalacOptions: T[Seq[String]] = super.scalacOptions() ++ Seq(
    "-source:future",
    "-rewrite",
    "-new-syntax",
    "-Wunused:all",
    "-encoding",
    "utf8",
    "-feature"
  ) ++ ciScalacOptions()

  object test
      extends ScalaTests
      with TestModule.Munit
      with ScoverageTests
      with ScalafixModule {
    override def munitVersion: T[String] = "1.3.4"
  }
}

object `joiners` extends MyJavaModule {

  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"pl.andrzejressel:oneof:0.0.2",
    mvn"io.arxila.javatuples:javatuples:2.0.1"
  )

  override def artifactName: T[String] = "joiners"
}

object `joiners4s` extends MyScalaModule {

  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`joiners`)

  override def artifactName: T[String] = "joiners4s"
}

object scoverage extends ScoverageReport {
  override def scalaVersion = "3.10.0"

  override def scoverageVersion = "2.5.2"
}
