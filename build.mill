//| mvnDeps:
//| - "com.goyeau::mill-scalafix::0.6.2"
//| - "com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION"
//| - "ch.epfl.scala:scalafix-interfaces:0.14.9" # Only new scalafix support 3.10
